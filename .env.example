# Local Docker Postgres (see docker-compose.yml). For Neon, use its connection string with sslmode=require.
DATABASE_URL=postgres://kollektiv:kollektiv@localhost:5432/kollektiv?sslmode=disable

# 32+ random bytes, e.g. `openssl rand -base64 32`
SESSION_SECRET=

# TRV address UUID for Eidsvolls gate 5
TRV_ADDRESS_ID=8843e8c5-6268-4c6f-bd7c-27b7dd1e1d03
